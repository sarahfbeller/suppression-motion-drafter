            "op": "includes",
            "value": "tip"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "high_crime_area"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "nervousness"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "time_of_day"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "furtive_movements"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "known_vehicle_or_person"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "matched_description"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "flight"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "observed_crime"
          }
        ]
      },
      "sentences": [
        {
          "id": "criminal_basis",
          "text": "Under the Fourth Amendment to the United States Constitution, an officer cannot stop a person without reasonable suspicion of criminal activity.",
          "authorities": [
            {
              "type": "case",
              "name": "Terry v. Ohio",
              "citation": "392 U.S. 1 (1968)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        }
      ]
    },
    {
      "id": "general_basis",
      "when": {
        "any": [
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "other"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "no_reason"
          }
        ]
      },
      "sentences": [
        {
          "id": "general_basis",
          "text": "An officer may not stop a vehicle without reasonable suspicion that the driver or an occupant is subject to seizure for a violation of law.",
          "authorities": [
            {
              "type": "case",
              "name": "Delaware v. Prouse",
              "citation": "440 U.S. 648 (1979)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        }
      ]
    },
    {
      "id": "alaska_coleman_standard",
      "applicable_courts": [
        "ak"
      ],
      "sentences": [
        {
          "id": "alaska_goes_further",
          "text": "The Alaska constitution goes further.",
          "authorities": [
            {
              "type": "case",
              "name": "Brown v. State",
              "citation": "182 P.3d 624 (Alaska App. 2008)",
              "court": "ak",
              "pincite": "626",
              "signal": "See"
            }
          ]
        },
        {
          "id": "coleman_standard",
          "text": "Under *Coleman*, a police officer may only temporarily detain someone for an investigative stop if the officer “has a reasonable suspicion that imminent public danger exists or serious harm to persons or property has recently occurred.”",
          "authorities": [
            {
              "type": "case",
              "name": "Coleman v. State",
              "citation": "553 P.2d 40 (Alaska 1976)",
              "court": "ak",
              "pincite": "46"
            }
          ]
        },
        {
          "id": "state_burden",
          "text": "Once the constitutionality of police action is challenged, the State bears the burden of showing that the officer’s actions were reasonable.",
          "authorities": [
            {
              "type": "case",
              "name": "Hays v. State",
              "citation": "850 P.2d 651 (Alaska App. 1993)",
              "court": "ak",
              "pincite": "653",
              "signal": "See"
            }
          ]
        },
        {
          "id": "balancing_test",
          "text": "Courts in Alaska use a balancing test to determine whether the officer’s suspicion was reasonable and sufficient for a stop.",
          "authorities": [
            {
              "type": "case",
              "name": "State v. Miller",
              "citation": "207 P.3d 541 (Alaska 2009)",
              "court": "ak",
              "pincite": "544",
              "signal": "See",
              "parenthetical": {
                "text": "discussing balancing test set forth in",
                "authority": {
                  "type": "case",
                  "name": "State v. G.B.",
                  "citation": "769 P.2d 452 (Alaska App. 1989)",
                  "court": "ak",
                  "pincite": "455–56"
                }
              }
            }
          ]
        },
        {
          "id": "balancing_factors",
          "text": "Under this balancing test, courts weigh the “degree of threat to public safety and the imminence of that threat” against the “strength of the officer’s reasonable suspicion and intrusiveness of the stop.”",
          "authorities": [
            {
              "type": "case",
              "name": "State v. Miller",
              "citation": "207 P.3d 541 (Alaska 2009)",
              "court": "ak",
              "pincite": "544"
            }
          ]
        },
        {
          "id": "degree_requires_threat",
          "kind": "argument",
          "text": "Weighing the “degree” of the public safety threat requires that there be some public safety threat—the officer has to see some evidence of a crime or threat to public safety.",
          "authorities": []
        },
        {
          "id": "tire_spinning_example",
          "text": "For example, if an officer observes a car spinning its tires—not itself an offense—that is likely insufficient to tip the scale in favor of a justified stop.",
          "authorities": [
            {
              "type": "case",
              "name": "Burnett v. State",
              "citation": "264 P.3d 607 (Alaska App. 2011)",
              "court": "ak",
              "pincite": "611–12",
              "signal": "See"
            }
          ]
        }
      ]
    },
