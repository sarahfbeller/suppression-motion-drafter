          ]
        },
        "flag": "mistake_of_law",
        "display_note": "If the dispute is that the conduct isn't actually a violation, expect the prosecution to argue the officer made a reasonable mistake of law, which can still support a stop (Heien v. North Carolina, 574 U.S. 54 (2014)). Be ready to show the statute is clear and the officer's reading wasn't reasonable."
      },
      {
        "when": {
          "question": "q_cited_conduct_happened",
          "op": "equals",
          "value": "not_sure"
        },
        "flag": "cited_conduct_unknown",
        "display_note": "You aren't sure yet whether the traffic violation or vehicle problem the officer described actually happened. This section was drafted anyway; get the dash-cam footage, the officer's report, and dispatch records before filing, or cut this section."
      },
      {
        "when": {
          "question": "q_stop_reasons",
          "op": "includes",
          "value": "other"
        },
        "flag": "other_stop_basis",
        "display_note": "The officer gave a reason for the stop that isn't on the list. Expect the prosecution to rely on it, or on a different justification such as community caretaking; this section argues only that reasonable suspicion was lacking, so evaluate that reason and address any other justification separately."
      },
      {
        "when": {
          "question": "q_warrant_found",
          "op": "equals",
          "value": "yes"
        },
        "flag": "strieff_attenuation",
        "display_note": "Police found an outstanding warrant for your client. Expect the prosecution to argue under Utah v. Strieff that the warrant attenuates the connection between the stop and the evidence."
      }
    ]
