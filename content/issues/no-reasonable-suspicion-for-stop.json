      },
      "sentences": [
        {
          "id": "hunch_insufficient",
          "text": "An officer's unparticularized suspicion or hunch is not enough.",
          "authorities": [
            {
              "type": "case",
              "name": "Terry v. Ohio",
              "citation": "392 U.S. 1 (1968)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        },
        {
          "id": "high_crime_area_alone",
          "text": "Presence in an area of expected criminal activity, standing alone, does not supply reasonable suspicion.",
          "authorities": [
            {
              "type": "case",
              "name": "Brown v. Texas",
              "citation": "443 U.S. 47 (1979)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        }
      ]
