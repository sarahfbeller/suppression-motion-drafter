  "law_paragraphs": [
    {
      "id": "main",
      "sentences": [
        {
          "id": "stop_is_seizure",
          "text": "Stopping an automobile and detaining its occupants is a seizure under the Fourth Amendment.",
          "authorities": [
            {
              "type": "case",
              "name": "Delaware v. Prouse",
              "citation": "440 U.S. 648 (1979)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        },
        {
          "id": "particularized_basis",
          "text": "Reasonable suspicion requires a particularized and objective basis for suspecting the particular person stopped of wrongdoing.",
          "authorities": [
            {
              "type": "case",
              "name": "United States v. Cortez",
              "citation": "449 U.S. 411 (1981)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        }
      ]
    },
    {
      "id": "passenger_seized",
      "when": {
        "question": "q_occupant_role",
        "op": "equals",
        "value": "passenger"
      },
      "sentences": [
        {
          "id": "passenger_seized",
          "text": "A passenger is seized by a traffic stop just as the driver is, and may challenge the stop's legality.",
          "authorities": [
            {
              "type": "case",
              "name": "Brendlin v. California",
              "citation": "551 U.S. 249 (2007)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        }
      ]
    },
    {
      "id": "traffic_basis",
      "when": {
        "any": [
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "traffic_violation"
          },
          {
            "question": "q_stop_reasons",
            "op": "includes",
            "value": "vehicle_problem"
          }
        ]
      },
      "sentences": [
        {
          "id": "traffic_basis",
          "text": "When the stop is based on a traffic violation, the officer must have at least articulable and reasonable suspicion that the driver or an occupant is subject to seizure for a violation of law; without it, stopping the vehicle is unreasonable.",
          "authorities": [
            {
              "type": "case",
              "name": "Delaware v. Prouse",
              "citation": "440 U.S. 648 (1979)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        }
      ]
    },
    {
      "id": "criminal_basis",
      "when": {
        "any": [
          {
