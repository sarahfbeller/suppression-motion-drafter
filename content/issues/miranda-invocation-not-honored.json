{
  "id": "miranda-invocation-not-honored",
  "label": "Invocation of the Right to Silence or Counsel Was Not Honored",
  "motion_heading": "Police Failed to Honor {client}'s Invocation of Miranda Rights",
  "status": "unreviewed",
  "last_reviewed": "",
  "reviewed_by": "",
  "applicable_courts": [
    "scotus"
  ],
  "trigger": {
    "match_condition": {
      "all": [
        {
          "question": "q_encounter_events",
          "op": "includes",
          "value": "statements"
        },
        {
          "any": [
            {
              "question": "q_custody_circumstances",
              "op": "includes",
              "value": "formally_arrested"
            },
            {
              "question": "q_custody_circumstances",
              "op": "includes",
              "value": "restrained"
            },
            {
              "question": "q_custody_circumstances",
              "op": "includes",
              "value": "confined"
            },
            {
              "all": [
                {
                  "any": [
                    {
                      "question": "q_custody_circumstances",
                      "op": "includes",
                      "value": "at_station"
                    },
                    {
                      "question": "q_custody_circumstances",
                      "op": "includes",
                      "value": "told_not_free"
                    },
                    {
                      "question": "q_custody_circumstances",
                      "op": "includes",
                      "value": "questioned_long"
                    },
                    {
                      "question": "q_custody_circumstances",
                      "op": "includes",
                      "value": "officers_or_weapons"
                    }
                  ]
                },
                {
                  "question": "q_custody_circumstances",
                  "op": "not_includes",
                  "value": "told_free_to_leave"
                }
              ]
            },
            {
              "question": "q_custody_circumstances",
              "op": "includes",
              "value": "not_sure"
            }
          ]
        },
        {
          "question": "q_invocation",
          "op": "not_empty"
        },
        {
          "question": "q_after_invocation",
          "op": "in",
          "value": [
            "continued",
            "resumed"
          ]
        }
      ]
    },
    "review_conditions": [
      {
        "when": {
          "question": "q_custody_circumstances",
          "op": "includes",
          "value": "not_sure"
        },
        "flag": "custody_unknown",
        "display_note": "You aren't sure yet whether your client was in custody. This section was drafted anyway; pin down whether your client was under arrest or restrained like an arrest (handcuffs, locked car, told not free to leave) before filing, or cut this section."
      },
      {
        "when": {
          "question": "q_invocation",
          "op": "includes",
          "value": "ambiguous"
        },
        "flag": "ambiguous_invocation",
        "display_note": "If your client's words were arguably ambiguous, expect the prosecution to argue they didn't invoke at all: an invocation of counsel must be unambiguous (*Davis v. United States*, 512 U.S. 452 (1994)), and the same applies to silence (*Berghuis v. Thompkins*, 560 U.S. 370 (2010)). Get the exact words."
      },
      {
        "when": {
          "all": [
            {
              "question": "q_custody_circumstances",
              "op": "not_includes",
              "value": "formally_arrested"
            },
            {
              "question": "q_custody_circumstances",
              "op": "not_includes",
              "value": "restrained"
            },
            {
              "question": "q_custody_circumstances",
              "op": "not_includes",
              "value": "confined"
            },
            {
              "all": [
                {
                  "any": [
                    {
                      "question": "q_custody_circumstances",
                      "op": "includes",
                      "value": "at_station"
                    },
                    {
                      "question": "q_custody_circumstances",
                      "op": "includes",
                      "value": "told_not_free"
                    },
                    {
                      "question": "q_custody_circumstances",
                      "op": "includes",
                      "value": "questioned_long"
                    },
                    {
                      "question": "q_custody_circumstances",
                      "op": "includes",
                      "value": "officers_or_weapons"
                    }
                  ]
                },
                {
                  "question": "q_custody_circumstances",
                  "op": "not_includes",
                  "value": "told_free_to_leave"
                }
              ]
            }
          ]
        },
        "flag": "custody_totality",
        "display_note": "Your client wasn't formally arrested, restrained, or confined, so whether they were in custody will be decided on the totality of the circumstances. Expect the prosecution to argue a reasonable person would have felt free to leave; develop every circumstance of the questioning (where, how long, who was there, what was said)."
      },
      {
        "when": {
          "all": [
            {
              "question": "q_custody_circumstances",
              "op": "includes",
              "value": "told_free_to_leave"
            },
            {
              "any": [
                {
                  "question": "q_custody_circumstances",
                  "op": "includes",
                  "value": "formally_arrested"
                },
                {
                  "question": "q_custody_circumstances",
                  "op": "includes",
                  "value": "restrained"
                },
                {
                  "question": "q_custody_circumstances",
                  "op": "includes",
                  "value": "confined"
                }
              ]
            }
          ]
        },
        "flag": "custody_told_free_but_restrained",
        "display_note": "Police told your client they were free to leave, but your client was arrested, restrained, or confined. Expect the prosecution to rely on that statement; the restraint is what a reasonable person would have experienced."
      }
    ]
  },
  "law_paragraphs": [
    {
      "id": "main",
      "sentences": [
        {
          "id": "must_cease",
          "text": "If a person in custody indicates in any manner, at any time before or during questioning, that they wish to remain silent or want an attorney, the interrogation must cease.",
          "authorities": [
            {
              "type": "case",
              "name": "Miranda v. Arizona",
              "citation": "384 U.S. 436 (1966)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        }
      ]
    },
    {
      "id": "scrupulously_honored",
      "when": {
        "question": "q_invocation",
        "op": "includes",
        "value": "said_wanted_silence"
      },
      "sentences": [
        {
          "id": "scrupulously_honored",
          "text": "The right to cut off questioning must be scrupulously honored.",
          "authorities": [
            {
              "type": "case",
              "name": "Michigan v. Mosley",
              "citation": "423 U.S. 96 (1975)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        }
      ]
    },
    {
      "id": "no_further_interrogation_counsel",
      "when": {
        "question": "q_invocation",
        "op": "includes",
        "value": "asked_for_lawyer"
      },
      "sentences": [
        {
          "id": "no_further_interrogation_counsel",
          "text": "Once a person in custody has asked for counsel, police may not interrogate further until counsel has been made available, unless the person initiates further communication.",
          "authorities": [
            {
              "type": "case",
              "name": "Edwards v. Arizona",
              "citation": "451 U.S. 477 (1981)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        },
        {
          "id": "counsel_present",
          "text": "After a request for counsel, questioning may not resume without counsel present, even if the person has since consulted with an attorney.",
          "authorities": [
            {
              "type": "case",
              "name": "Minnick v. Mississippi",
              "citation": "498 U.S. 146 (1990)",
              "court": "scotus",
              "pincite": ""
            }
          ]
        }
      ]
    }
  ],
  "practice_notes": [],
  "_author_notes": [
    "REVIEW CAREFULLY (legal judgment not yet reviewed): custody is treated as shown when q_custody_circumstances includes a formal arrest, restraint, or confinement (even if police said your client was free to leave, at the maintainer's instruction), or any softer fact (station or jail, told not free to leave, long questioning, several officers or weapons) without being told they were free to leave. 'Not sure yet' keeps the issue, with the custody_unknown note. Drafted by Claude on 2026-10-12; the custody_totality and custody_told_free_but_restrained review notes are Claude's drafts too. Not yet legally agreed.",
    "Supreme Court citations in this file were added from memory (not checked against the opinions) under the maintainer's 'certain SCOTUS cites only' policy: Miranda v. Arizona, Michigan v. Mosley, Edwards v. Arizona, Minnick v. Mississippi. Unverified; pincites empty."
  ]
}
